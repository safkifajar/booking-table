# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user uploads (avatar, story, etc) — runtime data, jangan masuk repo
/public/uploads/**
!/public/uploads/.gitkeep

# Dokumen internal — LOKAL saja, jangan ikut repo (permintaan user).
# Seluruh isi docs/ diabaikan. DEPLOYMENT.md tetap di repo (sudah ter-track
# sebelum aturan ini & dirujuk README). schema.md DICABUT 2026-08-28: ia
# dibangkitkan `npm run docs:schema` dari database, jadi menyimpan salinannya
# di repo cuma menghasilkan versi usang yang menyesatkan.
docs/

# Pengaturan alat bantu ngoding — milik mesin masing-masing, bukan bagian
# aplikasi. settings.local.json bahkan berisi izin perintah per-orang.
.claude/
