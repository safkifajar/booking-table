# ============================================================
# CATATAN MULTI-ENVIRONMENT (staging + production)
# ============================================================
# Kalau pakai staging + production (lihat docs/DEPLOYMENT.md section 11), tiap
# environment punya .env.local sendiri di foldernya. Var yang WAJIB BEDA antar
# env: DATABASE_URL, AUTH_URL, UPLOADS_DIR, AUTH_SECRET, CRON_SECRET,
# NEXT_PUBLIC_DEMO_MODE. Sisanya boleh sama.

# ============================================================
# DATABASE — Postgres (Drizzle ORM via postgres.js driver)
# ============================================================
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Production di VPS: pakai password kuat (32+ chars random), bind ke localhost
# Local dev: pakai docker compose (lihat docker-compose.yml)
# Multi-env: prod → DB soho_prod, staging → DB soho_staging (BEDA).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/booking_table

# ============================================================
# AUTH.JS v5 — session encryption & callbacks
# ============================================================
# Generate baru untuk production: `npx auth secret` atau `openssl rand -base64 32`
# JANGAN reuse dev secret di production
AUTH_SECRET=CHANGE_ME_GENERATE_FRESH

# Public origin (Auth.js pakai untuk redirect & cookie scope)
# Production: https://booking.yourdomain.com
# Dev: http://localhost:3000
AUTH_URL=http://localhost:3000

# ============================================================
# RESEND — transactional email (magic link signin)
# ============================================================
# Sign up gratis: https://resend.com (3K email/bulan gratis tier)
RESEND_API_KEY=re_CHANGE_ME

# Sender address
# Dev: onboarding@resend.dev (Resend test domain, no setup needed)
# Production: noreply@yourdomain.com (perlu verify domain di Resend dashboard
#             — DNS records DKIM/SPF, supaya tidak masuk spam)
RESEND_FROM=onboarding@resend.dev

# ============================================================
# APP CONFIG
# ============================================================
# Slug bar default (untuk single-tenant deployment)
NEXT_PUBLIC_BAR_SLUG=soho-purwokerto

# Demo mode: semua payment otomatis "paid" (untuk demo client, tanpa
# integrasi real payment gateway).
# Production: set ke "false" — hanya method "mock" yang auto-paid.
NEXT_PUBLIC_DEMO_MODE=true

# ============================================================
# PAYMENT GATEWAY
# ============================================================
# Driver aktif: "mock" (default, manual mark-paid) atau "duitku".
PAYMENT_GATEWAY=mock

# --- Duitku (QRIS) — hanya perlu kalau PAYMENT_GATEWAY=duitku ---
# Dapatkan dari dashboard Duitku → Proyek → Detail (Merchant Code + API Key).
# JANGAN isi nilai asli di file ini (ini TEMPLATE, di-track git). Isi nilai
# asli di .env.local di server (tidak di-commit).
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# "sandbox" (testing) atau "production".
DUITKU_ENV=sandbox
# URL publik endpoint callback kita (WAJIB didaftarkan juga di dashboard Duitku):
#   https://<domain>/api/payments/duitku/callback
DUITKU_CALLBACK_URL=
# URL kembali setelah bayar (opsional; default = callback url).
DUITKU_RETURN_URL=

# ============================================================
# CRON — story expire job authentication
# ============================================================
# Bearer token untuk endpoint POST /api/cron/expire-stories.
# Generate: `openssl rand -base64 32`
# Trigger setup di systemd timer / PM2 cron — lihat docs/DEPLOYMENT.md
CRON_SECRET=CHANGE_ME_GENERATE_FRESH

# ============================================================
# STORAGE — file uploads (avatar, story)
# ============================================================
# Driver: "local" (filesystem) atau "r2" (future, Cloudflare R2)
STORAGE_DRIVER=local

# Folder untuk simpan upload files.
# Dev: kosongkan, default ke <project>/public/uploads (Next.js auto-serve)
# Production: set ke folder di luar project supaya tidak ke-bundle saat build
#             dan persistent saat update deployment.
#             Recommended: UPLOADS_DIR=/var/lib/booking-table/uploads
# UPLOADS_DIR=

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ============================================================
# SENTRY (error monitoring) — OPSIONAL
# ============================================================
# Kosongkan di development: error saat ngoding tak perlu masuk Sentry.
# Isi HANYA di staging & production (VPS).
#
# DSN sama untuk client & server (ambil dari Sentry > Project Settings > Client Keys).
# NEXT_PUBLIC_ dipakai browser, tanpa prefix dipakai server.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Penanda environment supaya error staging & production terpisah di dashboard.
# Isi: "staging" atau "production".
NEXT_PUBLIC_SENTRY_ENV=production
SENTRY_ENV=production

# Token untuk upload source map saat build (stack trace jadi terbaca).
# Buat di: Sentry > Settings > Auth Tokens (scope: project:releases).
# Tanpa ini build tetap sukses, hanya stack trace kurang detail.
SENTRY_AUTH_TOKEN=
